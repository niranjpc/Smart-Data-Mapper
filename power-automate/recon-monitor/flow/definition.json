{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "name": "Reconciliation Monitor – daily refresh",
    "note": "Reference definition: what 'Peek code' shows for each step once the flow is built in the designer. Values in CAPITALS are tenant-specific and are picked in the designer (site, library, workbook). See ../README.md, section 'Power Automate flow'."
  },
  "parameters": {
    "$connections": { "defaultValue": {}, "type": "Object" },
    "$authentication": { "defaultValue": {}, "type": "SecureObject" }
  },
  "triggers": {
    "Every_morning": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "timeZone": "Eastern Standard Time",
        "schedule": { "hours": ["7"], "minutes": [15] }
      }
    }
  },
  "actions": {
    "Settings": {
      "type": "Compose",
      "runAfter": {},
      "inputs": {
        "siteUrl": "https://TENANT.sharepoint.com/sites/TechOps",
        "configPath": "/Shared Documents/Recon/Monitor/recon-config.json",
        "templatePath": "/Shared Documents/Recon/Monitor/recon-monitor.template.html",
        "archiveFolder": "/Shared Documents/Recon/Archive",
        "outputFolder": "/sites/TechOps/Shared Documents/Recon/Monitor",
        "pageFile": "Reconciliation-Monitor.html",
        "digestFile": "recon-digest.json",
        "timeZone": "Eastern Standard Time",
        "mailTo": "techops-recon@TENANT.com"
      }
    },
    "Get_config": {
      "type": "OpenApiConnection",
      "runAfter": { "Settings": ["Succeeded"] },
      "inputs": {
        "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline", "connectionName": "shared_sharepointonline", "operationId": "GetFileContentByPath" },
        "parameters": { "dataset": "@outputs('Settings')?['siteUrl']", "path": "@outputs('Settings')?['configPath']", "inferContentType": false },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Get_template": {
      "type": "OpenApiConnection",
      "runAfter": { "Settings": ["Succeeded"] },
      "inputs": {
        "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline", "connectionName": "shared_sharepointonline", "operationId": "GetFileContentByPath" },
        "parameters": { "dataset": "@outputs('Settings')?['siteUrl']", "path": "@outputs('Settings')?['templatePath']", "inferContentType": false },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Get_archived_weeks": {
      "type": "OpenApiConnection",
      "runAfter": { "Settings": ["Succeeded"] },
      "inputs": {
        "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline", "connectionName": "shared_sharepointonline", "operationId": "GetFileItems" },
        "parameters": {
          "dataset": "@outputs('Settings')?['siteUrl']",
          "table": "DOCUMENT_LIBRARY_HOLDING_THE_ARCHIVE",
          "$filter": "FSObjType eq 0",
          "$orderby": "Modified asc",
          "$top": 500,
          "folderPath": "@outputs('Settings')?['archiveFolder']",
          "viewScopeOption": "Default"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Only_workbooks": {
      "type": "Query",
      "runAfter": { "Get_archived_weeks": ["Succeeded"] },
      "inputs": {
        "from": "@body('Get_archived_weeks')?['value']",
        "where": "@and(or(endsWith(toLower(item()?['{FilenameWithExtension}']), '.xlsx'), endsWith(toLower(item()?['{FilenameWithExtension}']), '.xlsm')), not(startsWith(item()?['{FilenameWithExtension}'], '~')))"
      }
    },
    "Initialize_archive": {
      "type": "InitializeVariable",
      "runAfter": { "Only_workbooks": ["Succeeded"] },
      "inputs": { "variables": [{ "name": "archive", "type": "array", "value": [] }] }
    },
    "For_each_archived_week": {
      "type": "Foreach",
      "runAfter": { "Initialize_archive": ["Succeeded"], "Get_config": ["Succeeded"] },
      "foreach": "@body('Only_workbooks')",
      "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
      "actions": {
        "Run_script_on_archived_week": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness", "connectionName": "shared_excelonlinebusiness", "operationId": "RunScriptProd" },
            "parameters": {
              "source": "@outputs('Settings')?['siteUrl']",
              "drive": "DOCUMENT_LIBRARY_HOLDING_THE_ARCHIVE",
              "file": "@items('For_each_archived_week')?['{Identifier}']",
              "scriptId": "ReconMonitor",
              "ScriptParameters/configJson": "@{base64ToString(body('Get_config')?['$content'])}",
              "ScriptParameters/asOf": "@{convertTimeZone(utcNow(), 'UTC', outputs('Settings')?['timeZone'], 'yyyy-MM-dd')}",
              "ScriptParameters/mode": "extract",
              "ScriptParameters/archiveJson": ""
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Add_week": {
          "type": "AppendToArrayVariable",
          "runAfter": { "Run_script_on_archived_week": ["Succeeded"] },
          "inputs": { "name": "archive", "value": "@body('Run_script_on_archived_week')?['result']?['extractJson']" }
        }
      }
    },
    "Run_script": {
      "type": "OpenApiConnection",
      "runAfter": { "For_each_archived_week": ["Succeeded"], "Get_template": ["Succeeded"] },
      "inputs": {
        "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness", "connectionName": "shared_excelonlinebusiness", "operationId": "RunScriptProd" },
        "parameters": {
          "source": "@outputs('Settings')?['siteUrl']",
          "drive": "DOCUMENT_LIBRARY_HOLDING_THE_CURRENT_WORKBOOK",
          "file": "CURRENT_RECONCILIATION_REPORT.xlsx",
          "scriptId": "ReconMonitor",
          "ScriptParameters/configJson": "@{base64ToString(body('Get_config')?['$content'])}",
          "ScriptParameters/asOf": "@{convertTimeZone(utcNow(), 'UTC', outputs('Settings')?['timeZone'], 'yyyy-MM-dd')}",
          "ScriptParameters/mode": "build",
          "ScriptParameters/archiveJson": "@{concat('[', join(variables('archive'), ','), ']')}"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "If_nothing_was_read": {
      "type": "If",
      "runAfter": { "Run_script": ["Succeeded"] },
      "expression": { "equals": ["@body('Run_script')?['result']?['ok']", false] },
      "actions": {
        "Stop_and_keep_the_last_good_page": {
          "type": "Terminate",
          "inputs": { "runStatus": "Failed", "runError": { "code": "NoTrackerRows", "message": "@{join(body('Run_script')?['result']?['warnings'], ' | ')}" } }
        }
      },
      "else": { "actions": {} }
    },
    "Compose_page": {
      "type": "Compose",
      "runAfter": { "If_nothing_was_read": ["Succeeded"] },
      "inputs": "@replace(base64ToString(body('Get_template')?['$content']), '\"__RECON_DATA__\"', body('Run_script')?['result']?['dataJson'])"
    },
    "Save_page": {
      "type": "OpenApiConnection",
      "runAfter": { "Compose_page": ["Succeeded"] },
      "inputs": {
        "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline", "connectionName": "shared_sharepointonline", "operationId": "HttpRequest" },
        "parameters": {
          "dataset": "@outputs('Settings')?['siteUrl']",
          "parameters/method": "POST",
          "parameters/uri": "_api/web/GetFolderByServerRelativeUrl('@{outputs('Settings')?['outputFolder']}')/Files/add(url='@{outputs('Settings')?['pageFile']}',overwrite=true)",
          "parameters/headers": { "Accept": "application/json;odata=nometadata" },
          "parameters/body": "@{outputs('Compose_page')}"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Save_digest": {
      "type": "OpenApiConnection",
      "runAfter": { "Compose_page": ["Succeeded"] },
      "inputs": {
        "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline", "connectionName": "shared_sharepointonline", "operationId": "HttpRequest" },
        "parameters": {
          "dataset": "@outputs('Settings')?['siteUrl']",
          "parameters/method": "POST",
          "parameters/uri": "_api/web/GetFolderByServerRelativeUrl('@{outputs('Settings')?['outputFolder']}')/Files/add(url='@{outputs('Settings')?['digestFile']}',overwrite=true)",
          "parameters/headers": { "Accept": "application/json;odata=nometadata" },
          "parameters/body": "@{body('Run_script')?['result']?['digestJson']}"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Send_daily_digest": {
      "type": "OpenApiConnection",
      "runAfter": { "Save_page": ["Succeeded"] },
      "inputs": {
        "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365", "connectionName": "shared_office365", "operationId": "SendEmailV2" },
        "parameters": {
          "emailMessage/To": "@outputs('Settings')?['mailTo']",
          "emailMessage/Subject": "@body('Run_script')?['result']?['subject']",
          "emailMessage/Body": "<p style=\"font:13px Segoe UI,Arial\">Open the attached <b>Reconciliation-Monitor.html</b> for the full dashboard with customer drill-down (daily, weekly, monthly, historical).</p>@{body('Run_script')?['result']?['emailHtml']}@{if(empty(body('Run_script')?['result']?['warnings']), '', concat('<p style=\"color:#c77700;font:12px Segoe UI,Arial\"><b>Tracker warnings</b><br>', join(body('Run_script')?['result']?['warnings'], '<br>'), '</p>'))}",
          "emailMessage/Attachments": [
            { "Name": "@outputs('Settings')?['pageFile']", "ContentBytes": "@{base64(outputs('Compose_page'))}" }
          ],
          "emailMessage/Importance": "@if(body('Run_script')?['result']?['needsAttention'], 'High', 'Normal')"
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "outputs": {}
}
